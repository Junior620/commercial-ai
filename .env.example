# ─── Supabase (base de données + authentification) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : liens d'invitation et de réinitialisation du mot de passe
SUPABASE_SERVICE_ROLE_KEY=
# Production (Vercel) : utiliser le « Transaction pooler » Supabase (port 6543)
DATABASE_URL=
# Connexions par instance (défaut : 2 en production, 1 en dev)
DATABASE_POOL_MAX=

# ─── Accès (équipe fermée) ────────────────────────────────────────
# Emails autorisés d'office en administrateur (séparés par des virgules).
# Indispensable au premier lancement, sinon personne ne peut se connecter.
ADMIN_EMAILS=
# Facultatif : domaines dont les comptes Supabase sont admis comme « Commercial »
ALLOWED_EMAIL_DOMAINS=

# ─── IA (Anthropic Claude ; OpenAI en secours facultatif) ─────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high : profondeur de réflexion (low suffit pour des emails courts)
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# ─── Emails (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=commercial@votre-domaine.com
# Adresse de réponse (boîte réellement lue par l'équipe) ; défaut : RESEND_FROM_EMAIL
RESEND_REPLY_TO=
# Obligatoire en production : Resend > Webhooks > signing secret
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Obligatoire : secret de signature des liens de désinscription (16 caractères minimum).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
# Adresse postale affichée en pied d'email (sinon : Paramètres > Mentions légales). Obligatoire pour envoyer.
COMPANY_ADDRESS=
# Pays où seules les adresses génériques (contact@, info@…) sont contactées, sans relance.
# Codes ISO2 séparés par des virgules. Défaut : DE,ES,NL. À confirmer avec un conseil juridique.
STRICT_OPTIN_COUNTRIES=DE,ES,NL

# ─── Identité de l'expéditeur (signature des emails) ──────────────
SENDER_NAME=
SENDER_POSITION=
SENDER_COMPANY=SCPB
SENDER_PHONE=
SENDER_WEBSITE=https://votre-domaine.com
# URL absolue d'un logo (défaut : NEXT_PUBLIC_APP_URL/email-logo.png)
SENDER_LOGO_URL=

# ─── Recherche de prospects (Apify) ───────────────────────────────
APIFY_API_TOKEN=

# ─── Tâches de fond (Inngest) ─────────────────────────────────────
# En local : aucune clé, lancer « pnpm dev:jobs » à côté de « pnpm dev ».
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Application ──────────────────────────────────────────────────
# Une seule ligne. En production : l'adresse https publique (les liens de désinscription en dépendent).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fuseau des quotas journaliers et des envois planifiés
APP_TIMEZONE=Africa/Douala
