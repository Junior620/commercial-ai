# /opt/scpb-scraper/.env sur le VPS (chmod 600). Ne jamais le commiter.

# Jeton exigé sur chaque appel (24 caractères minimum). La même valeur va dans
# SCRAPER_WORKER_TOKEN côté application.
# Génération : openssl rand -hex 32
WORKER_TOKEN=

# Bright Data (facultatif : sans ces valeurs, le service lit les sites sans secours payant)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=

# Adresses publiques du serveur lui-même : le service ne les lit jamais (IPv4 et IPv6, séparées par des virgules)
BLOCKED_IPS=

# Réglages (valeurs par défaut entre parenthèses)
# SITE_CONCURRENCY=6      sites lus en parallèle
# MAX_BROWSER_PAGES=4     pages de navigateur en parallèle (0 = navigateur désactivé)
# PER_HOST_DELAY_MS=1000  délai entre deux requêtes vers un même site
